{
  "openapi": "3.1.0",
  "info": {
    "title": "Archive fixture",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://api.example.invalid/v1"
    }
  ],
  "security": [
    {
      "Session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "Session": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Receipt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/reports/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "view",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          }
        }
      }
    },
    "/reports/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Self"
          }
        }
      }
    },
    "/archive": {
      "get": {
        "responses": {
          "200": {
            "description": "Archived receipts"
          }
        }
      }
    }
  }
}
